{
  "manifest_version": 3,
  "name": "Quillcrypt",
  "version": "0.1.0",
  "description": "Collaborative, end-to-end encrypted web annotation.",
  "browser_specific_settings": {
    "gecko": {
      "id": "quillcrypt@yourdomain.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "websiteActivity"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["dist/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content-script.js"],
      "css": ["src/overlay/overlay.css", "src/ui/toolbar.css", "src/ui/sidebar.css", "src/ui/settings.css", "src/ui/onboarding.css", "src/ui/workspaceStatus.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Quillcrypt"
  }
}
